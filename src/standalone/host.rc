// ei_standalone.exe's one resource: its version information (S18j, C23). The game's own icons, cursors, bitmaps, dialogs
// and strings are not here: the strings are literals in our code (app_main.cpp, lib/mfc_resource.cpp) and the rest is
// never loaded. No icon yet (C24).
#include <winver.h>

#define EI_VERSION_NUMBER 1,6,0,0
#define EI_VERSION_TEXT "1.6.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EI_VERSION_NUMBER
 PRODUCTVERSION EI_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Evil Islands rebuild"
            VALUE "FileDescription", "Evil Islands rebuild, standalone host"
            VALUE "FileVersion", EI_VERSION_TEXT
            VALUE "InternalName", "ei_standalone"
            VALUE "OriginalFilename", "ei_standalone.exe"
            VALUE "ProductName", "Evil Islands (rebuild)"
            VALUE "ProductVersion", EI_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
