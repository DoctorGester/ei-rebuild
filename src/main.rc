// ei-rebuild.exe's resources: its icon and its version information (S18j, C23, C24). The game's own icons, cursors,
// bitmaps, dialogs and strings are not here: the strings are literals in our code (app/main_loop.cpp) and the rest is
// never loaded. The icon (assets/icon/ei-rebuild.ico, 16 to 256 px) is the first icon group, which Explorer shows and
// SDL takes for the window (SDL_RegisterApp).
#include <winver.h>

1 ICON "ei-rebuild.ico"

#define EI_VERSION_NUMBER 1,6,0,0
#define EI_VERSION_TEXT "1.6.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EI_VERSION_NUMBER
 PRODUCTVERSION EI_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Evil Islands rebuild"
            VALUE "FileDescription", "Evil Islands rebuild, standalone host"
            VALUE "FileVersion", EI_VERSION_TEXT
            VALUE "InternalName", "ei-rebuild"
            VALUE "OriginalFilename", "ei-rebuild.exe"
            VALUE "ProductName", "Evil Islands (rebuild)"
            VALUE "ProductVersion", EI_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
